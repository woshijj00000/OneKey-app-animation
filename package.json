{
  "name": "onekey-app-animation",
  "version": "1.0.0",
  "description": "Reusable 1080x1080 OneKey app social animation template",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.518",
    "@remotion/media": "4.0.518",
    "@remotion/tailwind-v4": "4.0.518",
    "@remotion/zod-types": "4.0.518",
    "mediabunny": "1.55.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.518",
    "tailwindcss": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.518",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render BulkSendFigmaUIOnlySquare out/bulk-send-figma-ui-only.mp4",
    "render:test-flow": "remotion render BulkSendTestSocialSquare out/bulk-send-test-social.mp4",
    "render:bulk-copy": "remotion render BulkCopyAddressesSocialSquare out/bulk-copy-addresses-social.mp4",
    "render:transfer-privacy": "remotion render OneKeyTransferAddressbookPrivacySquare out/onekey-transfer-addressbook-zh-v23-privacy-mask.mp4",
    "render:transfer-full-spec": "remotion render OneKeyTransferAddressbookFullSpecSquare out/onekey-transfer-addressbook-zh-v24-full-spec.mp4",
    "render:motion": "remotion render BulkSendMotionSquare out/bulk-send-motion-square.mp4",
    "render:recording": "remotion render PhoneProductDemoSquare out/bulk-send-square-demo.mp4",
    "generate:audio": "node scripts/generate-audio.mjs",
    "still": "remotion still BulkSendFigmaUIOnlySquare out/bulk-send-figma-ui-only-poster.png --frame=700",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "sideEffects": [
    "*.css"
  ]
}
